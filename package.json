{
  "name": "neon-grid",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  },
  "productName": "Neon Grid",
  "description": "GTA2-inspired top-down action prototype",
  "author": "Neon Grid Team",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.neongrid.game",
    "productName": "Neon Grid",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon Grid",
      "artifactName": "NeonGrid-Setup-${version}.exe"
    }
  }
}
